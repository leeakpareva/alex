{
  "rewrites": [
    { "source": "/", "destination": "/public/home.html" },
    { "source": "/dashboard", "destination": "/public/index.html" },
    { "source": "/api-library", "destination": "/public/api-library.html" },
    { "source": "/chat", "destination": "/public/chat.html" },
    { "source": "/experiment", "destination": "/public/experiment.html" },
    { "source": "/experiment/phase-1", "destination": "/public/experiment-phase-1.html" },
    { "source": "/experiment/phase-2", "destination": "/public/experiment-phase-2.html" },
    { "source": "/experiment/phase-3", "destination": "/public/experiment-phase-3.html" },
    { "source": "/experiment/phase-4", "destination": "/public/experiment-phase-4.html" },
    { "source": "/live-log", "destination": "/public/live-log.html" },
    { "source": "/articles", "destination": "/public/articles.html" },
    { "source": "/articles/alex-vs-openclaw", "destination": "/public/alex-vs-openclaw.html" },
    { "source": "/contact", "destination": "/public/contact.html" },
    { "source": "/faq", "destination": "/public/faq.html" },
    { "source": "/terms", "destination": "/public/terms.html" },
    { "source": "/navada-admin", "destination": "/public/navada-admin.html" },
    { "source": "/redis-viewer", "destination": "/public/redis-viewer.html" },
    { "source": "/api-learn", "destination": "/public/api-learn.html" },
    { "source": "/api/v1/:endpoint", "destination": "/api/v1/[endpoint].js" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, X-API-Key" }
      ]
    }
  ]
}
