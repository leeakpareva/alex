# ALEX Container Cron — Heartbeat Tasks
# Adapted from /etc/cron.d/alex for containerised deployment
# No user column (runs as root in container, curls to localhost)
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# 8am  — Morning briefing
0 8 * * *    curl -sf --retry 3 --retry-delay 30 --retry-connrefused -X POST http://localhost:9090/api/trigger -H 'Content-Type: application/json' -d '{"task":"morning-briefing"}' >> /home/alex/.alex/logs/cron.log 2>&1

